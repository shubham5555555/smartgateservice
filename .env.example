# Smart Gate backend — copy to .env and fill in real values.
# Full reference: ENVIRONMENT.md (repo docs)

# ── Server ───────────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/smartgate

# ── Redis (cache + image queue) ──────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Auth ─────────────────────────────────────────────────────────────────
# REQUIRED. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-64-char-random-hex-string

# Bootstrap platform admin (created as super_admin on first start when no admin users exist)
ADMIN_EMAIL=admin@smartgate.com
ADMIN_PASSWORD=change-me
# Preferred in production: bcrypt hash, takes precedence over ADMIN_PASSWORD
# ADMIN_PASSWORD_HASHED=$2b$10$YourHashedPasswordHere

# ── Email (Brevo REST API) — REQUIRED, the API refuses to start without the key
BREVO_API_KEY=xkeysib-your-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# ── Push notifications (Firebase Admin) ──────────────────────────────────
# Option 1 (preferred): put firebase-service-account.json in the backend root (git-ignored)
# Option 2: set all three below
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# ── File uploads (AWS S3) — without these, photo upload is disabled (503)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ── Optional ─────────────────────────────────────────────────────────────
# Legacy resident-visitor QR validity (commercial passes use per-site settings)
QR_VALIDITY_HOURS=24
